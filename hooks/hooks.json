{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/system/thor-system-prompt.md\"" } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*(gmail|Gmail).*(send|forward|reply)|mcp__.*(google-drive|Google_Drive).*(create|update|share|copy|trash)",
        "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/write_gate.py\"" } ]
      }
    ]
  }
}
